<Project Sdk="Microsoft.NET.Sdk">
  <!-- 澄沐 中控台：瀏覽官網服務助理的客服對話紀錄（Cloudflare D1：chengmu-chat-log）。
       單一 exe，不需要任何 DLL；外觀與 SE-Deploy.exe／SBK-Deploy.exe 同一家族（Ui*.cs 從 D:\SE_Dev\DeployTool 複製）。
       只讀資料、不需要系統管理員權限，Debug／Release 都用 asInvoker 的 app.manifest。 -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ChengMuConsole</RootNamespace>
    <AssemblyName>ChengMu-Console</AssemblyName>
    <AssemblyTitle>澄沐 中控台（客服紀錄）</AssemblyTitle>
    <Product>澄沐實業 官網</Product>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <!-- 單一檔案：不產生 .exe.config、除錯資訊包進 exe 不另帶 .pdb（照 SE-Deploy.csproj） -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>embedded</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <!-- ProtectedData（DPAPI 加密 API Token） -->
    <Reference Include="System.Security" />
    <!-- JavaScriptSerializer（net472 沒有 System.Text.Json） -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="testdata\**" />
  </ItemGroup>
</Project>
